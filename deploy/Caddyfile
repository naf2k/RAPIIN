{$RAPIIN_DOMAIN} {
    encode zstd gzip
    header {
        -Server
    }
    # The frontend owns the public surface: it serves the SPA and proxies /api
    # to the API service. Caddy only terminates TLS and forwards.
    reverse_proxy frontend:8080 {
        health_uri /healthz
        health_interval 15s
    }
}
