# RAPIIN server configuration
RAPIIN_DB_PATH=./data/rapiin.db
RAPIIN_DATABASE_URL=
RAPIIN_REDIS_URL=
RAPIIN_EMBEDDED_QUEUE_WORKER=false
RAPIIN_DATA_DIR=./data
RAPIIN_SECRET_KEY=replace-with-at-least-32-random-characters
# Production supports Docker/Kubernetes-style secret files instead:
RAPIIN_SECRET_KEY_FILE=
RAPIIN_MONITORING_TOKEN=replace-with-at-least-32-random-characters
RAPIIN_MONITORING_TOKEN_FILE=
RAPIIN_HOST=127.0.0.1
RAPIIN_PORT=8000
RAPIIN_ENV=development
RAPIIN_ALLOW_PUBLIC_REGISTRATION=true

# AI router (9router / OpenAI-compatible)
AI_BASE_URL=http://localhost:20128/v1
AI_API_KEY=
AI_API_KEY_FILE=
AI_MODEL=ai-rapiin
AI_MAX_RETRIES=5

# AI Operations Center (external delivery/deployment remains opt-in)
OPS_AGENTS_ENABLED=false
OPS_HERMES_COMMAND=hermes
OPS_HERMES_VERSION=v0.21.0
OPS_HERMES_COMMIT=95d42656021a22f20201c618a67da07a618d16f3
OPS_AGENT_TIMEOUT_SECONDS=180
OPS_AGENT_DAILY_RUN_LIMIT=100
OPS_AGENT_DAILY_COST_LIMIT_USD=10
OPS_AGENT_MONTHLY_COST_LIMIT_USD=100
OPS_AGENT_MAX_CONCURRENCY=1
OPS_AGENT_FAILURE_THRESHOLD=3
OPS_AGENT_CIRCUIT_COOLDOWN_SECONDS=900
OPS_RETENTION_DAYS=90
OPS_WORKTREE_ROOT=./data/ops-worktrees
OPS_GITHUB_REPO=owner/repository
OPS_PUBLIC_BASE_URL=http://127.0.0.1:8000
OPS_TELEGRAM_BOT_TOKEN=
OPS_TELEGRAM_BOT_TOKEN_FILE=
OPS_TELEGRAM_CHAT_ID=
OPS_DEPLOY_COMMAND=
OPS_ROLLBACK_COMMAND=
OPS_HEALTH_URL=http://127.0.0.1:8000/ready

# Default supervisor account created on first run
RAPIIN_INIT_SUPERVISOR_EMAIL=replace-with-operations-email@example.com
RAPIIN_INIT_SUPERVISOR_PASSWORD=replace-with-strong-unique-password-123
RAPIIN_INIT_SUPERVISOR_PASSWORD_FILE=
RAPIIN_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
