# BERESIN server configuration
BERESIN_DB_PATH=./data/beresin.db
BERESIN_DATA_DIR=./data
BERESIN_SECRET_KEY=replace-with-at-least-32-random-characters
# Production supports Docker/Kubernetes-style secret files instead:
BERESIN_SECRET_KEY_FILE=
BERESIN_MONITORING_TOKEN=replace-with-at-least-32-random-characters
BERESIN_MONITORING_TOKEN_FILE=
BERESIN_HOST=127.0.0.1
BERESIN_PORT=8000
BERESIN_ENV=development
BERESIN_ALLOW_PUBLIC_REGISTRATION=true

# AI router (9router / OpenAI-compatible)
AI_BASE_URL=http://localhost:20128/v1
AI_API_KEY=
AI_API_KEY_FILE=
AI_MODEL=ai-rapiin
AI_MAX_RETRIES=5

# AI Operations Center (external delivery/deployment remains opt-in)
OPS_AGENTS_ENABLED=false
OPS_HERMES_COMMAND=hermes
OPS_HERMES_VERSION=v0.21.0
OPS_HERMES_COMMIT=95d42656021a22f20201c618a67da07a618d16f3
OPS_AGENT_TIMEOUT_SECONDS=180
OPS_AGENT_DAILY_RUN_LIMIT=100
OPS_AGENT_MAX_CONCURRENCY=1
OPS_AGENT_FAILURE_THRESHOLD=3
OPS_AGENT_CIRCUIT_COOLDOWN_SECONDS=900
OPS_RETENTION_DAYS=90
OPS_WORKTREE_ROOT=./data/ops-worktrees
OPS_GITHUB_REPO=owner/repository
OPS_PUBLIC_BASE_URL=http://127.0.0.1:8000
OPS_TELEGRAM_BOT_TOKEN=
OPS_TELEGRAM_BOT_TOKEN_FILE=
OPS_TELEGRAM_CHAT_ID=
OPS_DEPLOY_COMMAND=
OPS_ROLLBACK_COMMAND=
OPS_HEALTH_URL=http://127.0.0.1:8000/ready

# Default supervisor account created on first run
BERESIN_INIT_SUPERVISOR_EMAIL=replace-with-operations-email@example.com
BERESIN_INIT_SUPERVISOR_PASSWORD=replace-with-strong-unique-password-123
BERESIN_INIT_SUPERVISOR_PASSWORD_FILE=
BERESIN_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
